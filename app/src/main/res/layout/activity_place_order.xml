<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/placeorder_background"
    tools:context=".PlaceOrder">

    <!-- Background Layer: Logo Centered in Background -->
    <ImageView
        android:id="@+id/bg_logo"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_gravity="center"
        android:alpha="0.25"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/img_1" />

    <!-- Foreground Layer: Product Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Product Image Card Frame (Blouse Image) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/product_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/product_blouse_desc_cd"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img" />
            </com.google.android.material.card.MaterialCardView>

            <!-- White Rounded Description Panel Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_description_panel"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- "Description" Main Header Text -->
                <TextView
                    android:id="@+id/txt_description_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="serif"
                    android:text="@string/description_title"
                    android:textColor="#000000"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <!-- Product Red Sub-Title Text -->
                <TextView
                    android:id="@+id/txt_product_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/product_blouse_title"
                    android:textColor="#D32F2F"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Long Body Text Block -->
                <TextView
                    android:id="@+id/txt_body_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.2"
                    android:text="@string/product_blouse_description"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <!-- Place Order Styled Button Layout Component -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_place_order"
                    android:layout_width="220dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_order_button"
                    android:gravity="center"
                    android:text="@string/place_order"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
