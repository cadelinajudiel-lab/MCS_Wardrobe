<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#87CEEB"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="40dp"
        android:text="PAYMENT METHOD"
        android:textColor="#000000"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Payment Options -->
    <RadioGroup
        android:id="@+id/rgPaymentMethods"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- GCash -->
        <LinearLayout
            android:id="@+id/optionGCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_option"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#007DFE" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="GCash"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbGCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#4CAF50"
                android:checked="true" />
        </LinearLayout>

        <!-- Mastercard -->
        <LinearLayout
            android:id="@+id/optionMastercard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_option"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#EB001B" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Mastercard"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbMastercard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#4CAF50" />
        </LinearLayout>

        <!-- VISA -->
        <LinearLayout
            android:id="@+id/optionVisa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_option"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <View
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="#1A1F71" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="VISA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/rbVisa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#4CAF50" />
        </LinearLayout>
    </RadioGroup>

    <!-- Spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="40dp" />

    <!-- Cost Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Original Price Row -->
        <LinearLayout
            android:id="@+id/rowOriginalPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Original Price"
                android:textColor="#555555"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvOriginalPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱1,380.00"
                android:textColor="#555555"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Discount Savings Row -->
        <LinearLayout
            android:id="@+id/rowDiscount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Discount Savings"
                android:textColor="#D32F2F"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiscountSavings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-₱552.00"
                android:textColor="#D32F2F"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Discounted Subtotal Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cost of purchase"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvCostOfPurchase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱828.00"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tax Fee Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tax fee"
                android:textColor="#000000"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvTaxFee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱5.00"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#CCCCCC" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱833.00"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Spacer to push button down -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Continue Button -->
    <Button
        android:id="@+id/btnContinue"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button"
        android:text="Continue"
        android:textColor="#000000"
        android:textSize="18sp" />

</LinearLayout>